@model List<Visitor>
@{
    Layout = "_AppLayout";
}

<div class="module-header">
    @if (ViewData["Role"] as string == "Employee" || ViewData["Role"] as string == "Manager")
    {
        <a class="btn btn-primary" asp-action="Create">+ Add visitor</a>
    }
    <form asp-action="Index" method="get" class="search-form">
        <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]" placeholder="Search by name..." />
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

<table class="data-table">
    <thead>
        <tr><th>Name</th><th>Organization</th><th>Position</th><th>Phone</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var visitor in Model)
        {
            <tr>
                <td>@visitor.Name</td>
                <td>@visitor.Organization</td>
                <td>@visitor.Position</td>
                <td>@visitor.Phone</td>
                <td>@visitor.Email</td>
                <td>
                    @if (ViewData["Role"] as string == "Employee" || ViewData["Role"] as string == "Manager")
                    {
                        <a asp-action="Edit" asp-route-id="@visitor.VisitorID">Edit</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>