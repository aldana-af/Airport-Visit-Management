@{
    ViewData["Title"] = "Choose Portal";
}

<div class="choose-portal-container">
    <h2>You have access to multiple portals</h2>
    <p>Which would you like to enter?</p>

    @if (User.IsInRole("Employee"))
    {
        <a class="btn btn-primary" asp-area="Employee" asp-controller="Visit" asp-action="Index">
            Employee Portal
        </a>
    }
    @if (User.IsInRole("Manager"))
    {
        <a class="btn btn-primary" asp-area="Manager" asp-controller="Approval" asp-action="Index">
            Manager Portal
        </a>
    }
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-controller="Admin" asp-action="Index">
            Admin Portal
        </a>
    }
</div>
