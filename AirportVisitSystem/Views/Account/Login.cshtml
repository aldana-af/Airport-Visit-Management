@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Airport Visitor Management</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-brand">
                <div class="login-brand-icon">&#9992;</div>
                <p class="login-brand-name">Airport visit management</p>
            </div>
            <p class="login-subtitle">Sign in to continue</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" />
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" />
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">Log in</button>
            </form>

            <p class="login-footer">Contact your administrator if you need access</p>
        </div>
    </div>
</body>
</html>
