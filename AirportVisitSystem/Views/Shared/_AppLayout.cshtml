<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Airport Visitor Management</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="topbar">
        <span class="greeting">@ViewData["Greeting"]</span>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn-logout">Logout</button>
        </form>
    </div>

    <div class="app-shell">
        <nav class="sidebar">
            @if (ViewData["Role"] as string == "Employee")
            {
                <a asp-controller="Home" asp-action="Employee">Home</a>
                <a asp-controller="Visitor" asp-action="Index">Visitors</a>
                <a asp-controller="Visit" asp-action="Index">Visits</a>
            }
            else if (ViewData["Role"] as string == "Manager")
            {
                <a asp-controller="Home" asp-action="Manager">Home</a>
                <a asp-controller="Visitor" asp-action="Index">Visitors</a>
                <a asp-controller="Visit" asp-action="Index">Visits</a>
                <a asp-controller="Approval" asp-action="Index">Approvals</a>
            }
        </nav>

        <main class="content">
            @RenderBody()
        </main>
    </div>
</body>
</html>