@model AdminHomeViewModel
@{
    Layout = "_AppLayout";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="module-header">
    <h2>Employee Hosts</h2>
    <a class="btn btn-primary" asp-action="RegisterEmployeeHost">Register Employee Host</a>
</div>
<table class="data-table">
    <thead><tr><th>Employee ID</th><th>Name</th><th></th></tr></thead>
    <tbody>
        @foreach (var host in Model.Hosts)
        {
            <tr>
                <td>@host.Id</td>
                <td>@host.Name</td>
                <td>
                    <form asp-action="DeleteEmployeeHost" asp-route-id="@host.Id" method="post" style="display:inline;" onsubmit="return confirm('Remove this Employee Host? This cannot be undone.');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="module-header" style="margin-top: 28px;">
    <h2>Site Visiting Managers</h2>
    <a class="btn btn-primary" asp-action="RegisterManager">Register Manager</a>
</div>
<table class="data-table">
    <thead><tr><th>Manager ID</th><th>Name</th></tr></thead>
    <tbody>
        @foreach (var manager in Model.Managers)
        {
            <tr>
                <td>@manager.Id</td>
                <td>@manager.Name</td>
                <td>
                    <form asp-action="DeleteManager" asp-route-id="@manager.Id" method="post" style="display:inline;" onsubmit="return confirm('Remove this Manager? This cannot be undone.');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>